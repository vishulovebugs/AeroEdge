# AeroEdge environment configuration.
# Copy to .env for local runs. Every variable here is REQUIRED by shared/config.js.

# Local LLM used for Edge Pass JEV evaluation and generation (Ollama model name).
OLLAMA_MODEL=llama3.1:8b

# Local embedding model served by Ollama (Ollama model name).
EMBEDDING_MODEL=nomic-embed-text

# HTTP endpoint of the Edge Qdrant instance (runs on/near the device).
QDRANT_EDGE_URL=http://localhost:6333

# HTTP endpoint of the Cloud Qdrant instance (fleet-side).
QDRANT_CLOUD_URL=http://localhost:6334
