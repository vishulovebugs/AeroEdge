[TEMPLATE]
# AeroEdge environment configuration.
# Copy to .env for local runs. Every variable here is REQUIRED by shared/config.js.

# Local LLM used for grounded generation, the JEV Edge Pass (edge/jev.js),
# and the JEV Cloud Pass (cloud/jevCloud.js) — three separate calls with
# separate roles and separate context.
OLLAMA_MODEL=llama3.1:8b

# Local embedding model served by Ollama (Ollama model name).
# Ingestion, query embedding, provisioning, and JEV context matching MUST
# use the same model/embedding space.
EMBEDDING_MODEL=nomic-embed-text

# HTTP endpoint of the Edge Qdrant instance (runs on/near the device).
QDRANT_EDGE_URL=http://localhost:6333

# HTTP endpoint of the Cloud Qdrant instance (fleet-side).
QDRANT_CLOUD_URL=http://localhost:6334

# Base URL of the local Ollama daemon (optional; defaults to the standard local port).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Name of the Edge-side Qdrant collection for ingested document chunks (optional).
QDRANT_EDGE_COLLECTION=aeroedge_edge_docs

# Name of the Cloud-side Qdrant collection for enterprise documents (optional;
# Phase 6 Cloud Knowledge Layer — architecturally separate from all edge stores).
QDRANT_CLOUD_COLLECTION=aeroedge_cloud_docs

# Phase 8 Sync Engine cloud-side collections (optional): synced technician
# memories and the SyncEvent audit trail — separate from enterprise docs
# (different trust path: edge-JEV'd, fleet-truth only after the Cloud Pass).
QDRANT_CLOUD_MEMORY_COLLECTION=aeroedge_cloud_memories
QDRANT_CLOUD_SYNC_COLLECTION=aeroedge_cloud_sync_events

# Phase 9: open Conflict records (version divergence between edge and cloud).
QDRANT_CLOUD_CONFLICT_COLLECTION=aeroedge_cloud_conflicts

# Phase 10: the human-review queue for Cloud Pass needs_human_review verdicts.
QDRANT_CLOUD_REVIEW_COLLECTION=aeroedge_cloud_review_queue
