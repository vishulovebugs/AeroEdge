[TEMPLATE]
# AeroEdge environment configuration.
# Copy to .env for local runs. Every variable here is REQUIRED by shared/config.js.

# Local LLM used for grounded generation AND for the JEV Edge Pass
# evaluation (edge/jev.js) — two separate calls with separate roles.
OLLAMA_MODEL=llama3.1:8b

# Local embedding model served by Ollama (Ollama model name).
# Ingestion and query embedding MUST use the same model/embedding space.
EMBEDDING_MODEL=nomic-embed-text

# HTTP endpoint of the Edge Qdrant instance (runs on/near the device).
QDRANT_EDGE_URL=http://localhost:6333

# HTTP endpoint of the Cloud Qdrant instance (fleet-side, Phase 6 Cloud
# Knowledge Layer: enterprise documents, pre-trusted, no JEV pass).
QDRANT_CLOUD_URL=http://localhost:6334

# Base URL of the local Ollama daemon (optional; defaults to the standard local port).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Name of the Edge-side Qdrant collection for ingested document chunks (optional).
QDRANT_EDGE_COLLECTION=aeroedge_edge_docs

# Name of the Cloud-side Qdrant collection for enterprise documents (optional;
# Phase 6 Cloud Knowledge Layer — architecturally separate from all edge stores).
QDRANT_CLOUD_COLLECTION=aeroedge_cloud_docs
